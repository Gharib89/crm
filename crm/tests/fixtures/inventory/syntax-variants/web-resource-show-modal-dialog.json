      "source": "// var r = showModalDialog(url);",
      "detected": true
    },
    "arrow-handler": {
      "variant": "arrow-handler",
      "source": "var h = () => window.showModalDialog(url);",
      "detected": true
    },
    "method-handler": {
      "variant": "method-handler",
      "source": "var o = { m() { return window.showModalDialog(url); } };",
      "detected": true
    },
    "substring-name": {
      "variant": "",
      "source": "var r = myshowModalDialog(url);",
