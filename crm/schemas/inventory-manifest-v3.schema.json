{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crm:inventory-manifest:3",
  "title": "crm migration inventory manifest, schema_version 3",
  "description": "The manifest.json of a migration inventory (ADR 0032). Readers ignore fields this schema does not define. The key rule (a record's key equals the component key of its fields), the coverage-per-kind rule and the record counts are checked by crm.core.inventory.parse_manifest, since JSON Schema cannot express them.",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "extracted_at",
    "cli_version",
    "scope",
    "publication",
    "records",
    "coverage",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "source": {
      "type": "object",
      "required": [
        "platform",
        "org_url",
        "organization_id",
        "version"
      ],
      "properties": {
        "platform": {
          "enum": [
            "crm2011",
            "onprem",
            "cloud"
          ]
        },
        "org_url": {
          "type": "string",
          "pattern": "^https?://[^/@]+(/.*)?$"
        },
        "organization_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extracted_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "when the extraction ran, an RFC 3339 date-time"
    },
    "cli_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "mode",
        "solutions"
      ],
      "properties": {
        "mode": {
          "enum": [
            "org",
            "solutions"
          ]
        },
        "solutions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "system": {
          "enum": [
            "included",
            "excluded"
          ]
        },
        "usage_read": {
          "type": "boolean",
          "description": "True when the extraction read usage (--with-usage); absent means false."
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "solutions"
          }
        }
      },
      "then": {
        "properties": {
          "solutions": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "solutions": {
            "maxItems": 0
          }
        }
      }
    },
    "publication": {
      "const": "published"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "coverage": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "entity",
          "attribute",
          "relationship",
          "global_option_set",
          "local_option_set",
          "form",
          "view",
          "web_resource",
          "plugin_assembly",
          "plugin_type",
          "step",
          "step_image",
          "process",
          "solution",
          "solution_membership",
          "dependency",
          "ribbon",
          "sitemap",
          "ribbon_diff"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/coverage"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "kind",
        "key",
        "id",
        "display_name",
        "origin",
        "managed",
        "publication_state",
        "fields",
        "artifacts"
      ],
      "properties": {
        "kind": {
          "enum": [
            "entity",
            "attribute",
            "relationship",
            "global_option_set",
            "local_option_set",
            "form",
            "view",
            "web_resource",
            "plugin_assembly",
            "plugin_type",
            "step",
            "step_image",
            "process",
            "solution",
            "solution_membership",
            "dependency",
            "ribbon",
            "sitemap",
            "ribbon_diff"
          ]
        },
        "key": {
          "type": "string",
          "description": "Non-empty, except the application ribbon, the default sitemap and the application ribbon diff, which key the empty string; parse_manifest enforces that."
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "enum": [
            "custom",
            "system",
            "unknown"
          ]
        },
        "managed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "publication_state": {
          "enum": [
            "published",
            "unknown"
          ]
        },
        "fields": {
          "type": "object"
        },
        "usage": {
          "type": "object",
          "description": "Present only on a record whose kind has a runtime signal, in a manifest whose scope.usage_read is true. Absent means not read, never unused.",
          "required": [
            "state",
            "signal",
            "value",
            "as_of",
            "reason"
          ],
          "properties": {
            "state": {
              "enum": [
                "used",
                "unused",
                "unknown"
              ]
            },
            "signal": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "as_of": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "entity"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "logical_name"
                ],
                "properties": {
                  "logical_name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/entity/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "attribute"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "entity",
                  "logical_name"
                ],
                "properties": {
                  "entity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "logical_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "max_length": {
                    "type": "integer",
                    "description": "String and Memo only. Every facet is recorded only for the types that define it, and is optional: a manifest written before they existed has none, and the diff compares a facet only where both sides recorded it."
                  },
                  "format": {
                    "type": "string",
                    "description": "The type's Format enum name (Text, TextArea, DateOnly, ...), for the types that have one."
                  },
                  "default_value": {
                    "type": [
                      "boolean",
                      "integer"
                    ],
                    "description": "Boolean DefaultValue, or the Picklist's DefaultFormValue (-1 is no default)."
                  },
                  "precision": {
                    "type": "integer"
                  },
                  "min_value": {
                    "type": "number"
                  },
                  "max_value": {
                    "type": "number"
                  },
                  "option_set_global": {
                    "type": "boolean",
                    "description": "Picklist only: whether its option set is a global one."
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/attribute/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "relationship"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "schema_name"
                ],
                "properties": {
                  "schema_name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/relationship/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "global_option_set"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/global_option_set/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "local_option_set"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "entity",
                  "attribute"
                ],
                "properties": {
                  "entity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attribute": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/local_option_set/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "form"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "entity",
                  "form_type",
                  "name"
                ],
                "properties": {
                  "entity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "form_type": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "libraries": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "web resource names of the form libraries, in load order"
                  },
                  "handlers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "event",
                        "attribute",
                        "function",
                        "library",
                        "enabled"
                      ],
                      "properties": {
                        "event": {
                          "type": "string",
                          "minLength": 1
                        },
                        "attribute": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "function": {
                          "type": "string",
                          "minLength": 1
                        },
                        "library": {
                          "type": "string",
                          "minLength": 1
                        },
                        "enabled": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/form/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "view"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "entity",
                  "name"
                ],
                "properties": {
                  "entity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/view/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "web_resource"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/web_resource/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "plugin_assembly"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/plugin_assembly/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "plugin_type"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "assembly",
                  "type_name"
                ],
                "properties": {
                  "assembly": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type_name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/plugin_type/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "step"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "message",
                  "primary_entity",
                  "stage",
                  "mode",
                  "plugin_type",
                  "name"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "primary_entity": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "stage": {
                    "type": "integer"
                  },
                  "mode": {
                    "type": "integer"
                  },
                  "plugin_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/step/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "step_image"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "step",
                  "alias",
                  "image_type"
                ],
                "properties": {
                  "step": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alias": {
                    "type": "string",
                    "minLength": 1
                  },
                  "image_type": {
                    "type": "integer"
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/step_image/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "process"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "category",
                  "primary_entity",
                  "name"
                ],
                "properties": {
                  "category": {
                    "type": "integer"
                  },
                  "primary_entity": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "activities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "plug-in type keys of the custom workflow activities the definition uses"
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/process/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "solution"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "unique_name"
                ],
                "properties": {
                  "unique_name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/solution/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "solution_membership"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "solution",
                  "member_kind",
                  "member_key"
                ],
                "properties": {
                  "solution": {
                    "type": "string",
                    "minLength": 1
                  },
                  "member_kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "member_key": {
                    "type": "string",
                    "description": "Non-empty, except a reference to the application ribbon or default sitemap, which is the empty string; parse_manifest enforces that."
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/solution_membership/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dependency"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "dependent_kind",
                  "dependent_key",
                  "required_kind",
                  "required_key",
                  "dependency_type"
                ],
                "properties": {
                  "dependent_kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dependent_key": {
                    "type": "string",
                    "description": "Non-empty, except a reference to the application ribbon or default sitemap, which is the empty string; parse_manifest enforces that."
                  },
                  "required_kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required_key": {
                    "type": "string",
                    "description": "Non-empty, except a reference to the application ribbon or default sitemap, which is the empty string; parse_manifest enforces that."
                  },
                  "dependency_type": {
                    "type": "integer"
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/dependency/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ribbon"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "entity"
                ],
                "properties": {
                  "entity": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/ribbon/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sitemap"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "unique_name"
                ],
                "properties": {
                  "unique_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/sitemap/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ribbon_diff"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "required": [
                  "entity"
                ],
                "properties": {
                  "entity": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                }
              },
              "artifacts": {
                "items": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/ribbon_diff/[^/]+$"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "content",
        "sha256",
        "normalized_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^artifacts/[a-z_]+/[^/]+$",
          "not": {
            "pattern": "/\\.\\.?$"
          }
        },
        "content": {
          "enum": [
            "text",
            "binary"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "normalized_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "status",
        "pages",
        "records",
        "truncated",
        "errors"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unsupported",
            "failed"
          ]
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "truncated": {
            "const": false
          }
        }
      }
    },
    "gap": {
