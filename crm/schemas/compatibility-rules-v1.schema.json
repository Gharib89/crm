{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gharib89/crm/blob/main/crm/schemas/compatibility-rules-v1.schema.json",
  "title": "crm compatibility rules, schema_version 1",
  "description": "The packaged compatibility rules `crm inventory assess` runs over a migration inventory (ADR 0033). Each rule names the component kind, the source versions and targets it applies to, a class, a detection, the fix and at least one Microsoft Learn page. A reader refuses an unknown schema_version.",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "description": "The rule set's revision, raised whenever a rule changes; a findings file names it.",
      "type": "integer",
      "minimum": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "class",
        "title",
        "source",
        "targets",
        "detection",
        "fix",
        "sources"
      ],
      "properties": {
        "id": {
          "description": "Stable id a finding names.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "entity",
            "attribute",
            "relationship",
            "global_option_set",
            "local_option_set",
            "form",
            "view",
            "web_resource",
            "plugin_assembly",
            "plugin_type",
            "step",
            "step_image",
            "process",
            "solution",
            "solution_membership",
            "dependency",
            "ribbon",
            "sitemap",
            "ribbon_diff",
            "report"
          ]
        },
        "class": {
          "enum": [
            "blocker",
            "deprecated",
            "optional"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "description": "The source versions the rule applies to: from `from` (inclusive) up to `before` (exclusive, null for no upper bound), compared with the inventory's source.version.",
          "type": "object",
          "required": [
            "from",
            "before"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/version"
            },
            "before": {
              "oneOf": [
                {
                  "$ref": "#/$defs/version"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "onprem-9.1",
              "online"
            ]
          }
        },
        "detection": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "pattern",
                "web_resource_types"
              ],
              "properties": {
                "type": {
                  "const": "content_pattern"
                },
                "pattern": {
                  "description": "A Python regular expression searched in the record's text artifacts.",
                  "type": "string",
                  "minLength": 1
                },
                "web_resource_types": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer"
                  }
                }
              }
            },
            {
              "description": "The source org's host names, which the run supplies (`crm inventory assess --source-host`) and the file never holds: the rule hits where the record's text artifacts name one. The rule does not run without a host. web_resource_types is required on kind web_resource and refused on any other.",
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "host_pattern"
                },
                "web_resource_types": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "pattern",
                "categories"
              ],
              "properties": {
                "type": {
                  "const": "xaml_pattern"
                },
                "pattern": {
                  "description": "A Python regular expression searched in the stored XAML of a process record. Valid on kind process only.",
                  "type": "string",
                  "minLength": 1
                },
                "categories": {
                  "description": "The process categories the rule judges (0 is a classic workflow).",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "field",
                "values"
              ],
              "properties": {
                "type": {
                  "const": "field_in"
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "values": {
                  "type": "array",
                  "minItems": 1
                }
              }
            },
            {
              "description": "A custom Reporting Services report (report_type 1, custom) judged by its recorded data_provider: a match is a hit, an `unknown` provider is an unknown finding carrying the record's data_provider_reason. Valid on kind report only.",
              "type": "object",
              "required": [
                "type",
                "provider"
              ],
              "properties": {
                "type": {
                  "const": "report_data_provider"
                },
                "provider": {
                  "enum": [
                    "fetch",
                    "sql"
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "library_rule"
              ],
              "properties": {
                "type": {
                  "const": "form_handler_context"
                },
                "library_rule": {
                  "description": "Id of a content_pattern rule: a form handler that does not pass the execution context is a hit when its library's text matches that rule.",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "library_rule",
                "adapter_pattern"
              ],
              "properties": {
                "type": {
                  "const": "form_library_order"
                },
                "library_rule": {
                  "description": "Id of a content_pattern rule: a form is a hit when it lists a script library matching that rule with no adapter library before it.",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "adapter_pattern": {
                  "description": "A Python regular expression: a library whose text matches it is the adapter.",
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "library_rule",
                "adapter_pattern"
              ],
              "properties": {
                "type": {
                  "const": "html_library_order"
                },
                "library_rule": {
                  "description": "Id of a content_pattern rule: an HTML page is a hit when a script it loads by src, or an inline script, matches that rule with no adapter script before it.",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "adapter_pattern": {
                  "description": "A Python regular expression: a library whose text matches it is the adapter.",
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "library_rule",
                "adapter_pattern"
              ],
              "properties": {
                "type": {
                  "const": "ribbon_library_order"
                },
                "library_rule": {
                  "description": "Id of a content_pattern rule: a ribbon command is a hit when an action calls a script library matching that rule with no adapter action before it, and a CustomRule calling such a library is a hit too.",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "adapter_pattern": {
                  "description": "A Python regular expression: a library whose text matches it is the adapter.",
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "library_rule",
                "parameter"
              ],
              "properties": {
                "type": {
                  "const": "ribbon_action_parameter"
                },
                "library_rule": {
                  "description": "Id of a content_pattern rule: a ribbon JavaScriptFunction lacking the parameter is a hit when its web resource library's text matches that rule.",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "parameter": {
                  "description": "The CrmParameter Value the action must pass.",
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "description": "A plug-in assembly whose project, as the source map names it, is below .NET Framework 4.6.2 or references the SDK 5.0 Microsoft.Xrm.Sdk or Microsoft.Crm.Sdk.Proxy. The repository, not the inventory, is read, so only `crm inventory assess --source-map --repo` runs it.",
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "plugin_project"
                }
              }
            },
            {
              "description": "A plug-in assembly whose project, as the source map names it, holds a C# file that creates an object of a listed type or accesses a member of one, resolved through the file's using directives, aliases and static imports or a fully qualified name. The repository, not the inventory, is read, so only `crm inventory assess --source-map --repo` runs it. A rule of this kind carries no transform: convert never rewrites C#.",
              "type": "object",
              "required": [
                "type",
                "entries"
              ],
              "properties": {
                "type": {
                  "const": "plugin_source"
                },
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "namespace",
                      "types"
                    ],
                    "properties": {
                      "namespace": {
                        "type": "string",
                        "minLength": 1
                      },
                      "types": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "fix": {
          "type": "string",
          "minLength": 1
        },
        "transform": {
          "description": "Id of the registered code transform `crm inventory convert` runs for this rule's findings. Optional: a rule without one is detect-only.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          },
          "contains": {
            "type": "string",
            "pattern": "^https://learn\\.microsoft\\.com/"
          }
        }
      }
    }
  }
}
