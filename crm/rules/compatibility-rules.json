{
  "schema_version": 1,
  "version": 3,
  "rules": [
    {
      "id": "web-resource-xrm-page",
      "kind": "web_resource",
      "class": "deprecated",
      "title": "Uses the deprecated Xrm.Page object",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "\\bXrm\\.Page\\b",
        "web_resource_types": [
          1,
          3
        ]
      },
      "transform": "global-context",
      "fix": "Use the form context: take executionContext.getFormContext() in a form handler (pass the execution context as the first parameter), or PrimaryControl in a ribbon command.",
      "sources": [
        "https://learn.microsoft.com/power-platform/important-changes-coming#some-client-apis-are-deprecated",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/clientapi-form-context",
        "https://learn.microsoft.com/power-apps/maker/data-platform/powerapps-checker/rules/web/use-client-context"
      ]
    },
    {
      "id": "web-resource-xrm-utility",
      "kind": "web_resource",
      "class": "deprecated",
      "title": "Uses deprecated Xrm.Utility navigation and dialog methods",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "\\bXrm\\.Utility\\.(openEntityForm|openQuickCreate|openWebResource|alertDialog|confirmDialog|isActivityType)\\b",
        "web_resource_types": [
          1,
          3
        ]
      },
      "fix": "Use Xrm.Navigation.openForm, openWebResource, openAlertDialog and openConfirmDialog, and Xrm.Utility.getEntityMetadata for activity checks.",
      "sources": [
        "https://learn.microsoft.com/power-platform/important-changes-coming#some-client-apis-are-deprecated"
      ],
      "transform": "xrm-utility-review"
    },
    {
      "id": "web-resource-get-server-url",
      "kind": "web_resource",
      "class": "deprecated",
      "title": "Reads the server URL through the deprecated context.getServerUrl",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "\\.\\s*getServerUrl\\s*\\(",
        "web_resource_types": [
          1,
          3
        ]
      },
      "fix": "Use Xrm.Utility.getGlobalContext().getClientUrl() (a standalone HTML web resource: ClientGlobalContext.js.aspx, then GetGlobalContext().getClientUrl()). Tool judgment: no Microsoft Learn page names getServerUrl; the sources are the closest statements.",
      "sources": [
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/clientapi-xrm#client-api-global-context",
        "https://learn.microsoft.com/dynamics365/customerengagement/on-premises/developer/web-resources?view=op-9-1#reference-web-resources"
      ]
    },
    {
      "id": "web-resource-context-settings",
      "kind": "web_resource",
      "class": "deprecated",
      "title": "Reads a user or organization setting through a global context method that moved",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "\\b(?:Xrm\\s*\\.\\s*Page\\s*\\.\\s*context|Xrm\\s*\\.\\s*Utility\\s*\\.\\s*getGlobalContext\\s*\\(\\s*\\))\\s*\\.\\s*(?:getUserName|getUserId|getUserLcid|getUserRoles|getOrgLcid|getOrgUniqueName|getIsAutoSaveEnabled|getTimeZoneOffsetMinutes)\\b",
        "web_resource_types": [
          1,
          3
        ]
      },
      "transform": "context-settings",
      "fix": "Read the property on Xrm.Utility.getGlobalContext().userSettings (userName, userId, languageId, roles, getTimeZoneOffsetMinutes()) or .organizationSettings (languageId, uniqueName, isAutoSaveEnabled). getUserRoles() returned GUID strings and userSettings.roles holds {id, name} lookups: review each read of the list.",
      "sources": [
        "https://learn.microsoft.com/power-platform/important-changes-coming#some-client-apis-are-deprecated",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/reference/xrm-utility/getglobalcontext/usersettings",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/reference/xrm-utility/getglobalcontext/organizationsettings",
        "https://learn.microsoft.com/power-apps/maker/data-platform/powerapps-checker/rules/web/use-org-setting"
      ]
    },
    {
      "id": "web-resource-grid-row",
      "kind": "web_resource",
      "class": "deprecated",
      "title": "Reads a grid row through the deprecated GridRow.getData or GridRowData.getEntity",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "\\.\\s*getData\\s*\\(\\s*\\)(?:\\s*\\.\\s*getEntity\\s*\\(\\s*\\))?|\\.\\s*getEntity\\s*\\(\\s*\\)",
        "web_resource_types": [
          1,
          3
        ]
      },
      "transform": "grid-row",
      "fix": "Use GridRow.data in place of getData() and GridRowData.entity in place of getEntity().",
      "sources": [
        "https://learn.microsoft.com/power-platform/important-changes-coming#some-client-apis-are-deprecated",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/reference/grids/gridrow",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/reference/grids/gridrowdata",
        "https://learn.microsoft.com/power-apps/maker/data-platform/powerapps-checker/rules/web/use-grid-api"
      ]
    },
    {
      "id": "web-resource-xrm-mobile-offline",
      "kind": "web_resource",
      "class": "deprecated",
      "title": "Uses the deprecated Xrm.Mobile.offline namespace",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "\\bXrm\\s*\\.\\s*Mobile\\s*\\.\\s*offline\\b",
        "web_resource_types": [
          1,
          3
        ]
      },
      "transform": "mobile-offline",
      "fix": "Use Xrm.WebApi.offline: the record methods keep their names, and isOfflineEnabled becomes isAvailableOffline.",
      "sources": [
        "https://learn.microsoft.com/power-platform/important-changes-coming#some-client-apis-are-deprecated",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/reference/xrm-webapi/offline",
        "https://learn.microsoft.com/power-apps/maker/data-platform/powerapps-checker/rules/web/use-offline"
      ]
    },
    {
      "id": "web-resource-entity-save",
      "kind": "web_resource",
      "class": "deprecated",
      "title": "Saves through the deprecated formContext.data.entity.save",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "\\.\\s*data\\s*\\.\\s*entity\\s*\\.\\s*save\\b",
        "web_resource_types": [
          1,
          3
        ]
      },
      "transform": "entity-save",
      "fix": "Use formContext.data.save, which takes a saveOptions object and runs asynchronously.",
      "sources": [
        "https://learn.microsoft.com/power-platform/important-changes-coming#some-client-apis-are-deprecated",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/reference/formcontext-data-entity/save",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/reference/formcontext-data/save"
      ]
    },
    {
      "id": "web-resource-keypress",
      "kind": "web_resource",
      "class": "deprecated",
      "title": "Uses the deprecated key-press and auto-complete methods",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "\\.\\s*(?:addOnKeyPress|removeOnKeyPress|fireOnKeyPress|showAutoComplete|hideAutoComplete)\\s*\\(",
        "web_resource_types": [
          1,
          3
        ]
      },
      "transform": "keypress-review",
      "fix": "No API replaces these methods: use a custom control built with the Power Apps component framework.",
      "sources": [
        "https://learn.microsoft.com/power-platform/important-changes-coming#some-client-apis-are-deprecated"
      ]
    },
    {
      "id": "web-resource-crmform",
      "kind": "web_resource",
      "class": "blocker",
      "title": "Uses the CRM 4.0 crmForm scripting object",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "\\bcrmForm(Submit)?\\b",
        "web_resource_types": [
          1,
          3
        ]
      },
      "fix": "Rewrite against the client API: crmForm.all.<attribute>.DataValue becomes formContext.getAttribute(\"<attribute>\").getValue(). crmForm is not part of the documented 9.x client API, and only the documented API is supported. Tool judgment: no Microsoft Learn page names crmForm; the sources are the closest statements.",
      "sources": [
        "https://learn.microsoft.com/dynamics365/customerengagement/on-premises/customize/customizations-supported?view=op-9-1",
        "https://learn.microsoft.com/power-apps/maker/data-platform/powerapps-checker/rules/web/avoid-2011-api"
      ]
    },
    {
      "id": "web-resource-soap-2007",
      "kind": "web_resource",
      "class": "blocker",
      "title": "Calls the CRM 4.0 2007 SOAP endpoint",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "(?i)/MSCrmServices/2007/",
        "web_resource_types": [
          1,
          3
        ]
      },
      "fix": "Call the Web API (Xrm.WebApi, or /api/data/v9.x/). The 9.x web services are the Web API, the Organization service and the Organization Data service; the 2007 endpoint is not among them. Tool judgment: no Microsoft Learn page names the 2007 endpoint; the sources are the closest statements.",
      "sources": [
        "https://learn.microsoft.com/dynamics365/customerengagement/on-premises/developer/use-microsoft-dynamics-365-web-services?view=op-9-1"
      ]
    },
    {
      "id": "web-resource-soap-2011",
      "kind": "web_resource",
      "class": "deprecated",
      "title": "Calls the deprecated CRM 2011 SOAP endpoint",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "(?i)/XRMServices/2011/(Organization|Discovery)\\.svc",
        "web_resource_types": [
          1,
          3
        ]
      },
      "fix": "Call the Web API (Xrm.WebApi, or /api/data/v9.x/).",
      "sources": [
        "https://learn.microsoft.com/power-apps/maker/data-platform/powerapps-checker/rules/web/avoid-crm2011-service-soap",
        "https://learn.microsoft.com/dynamics365/customerengagement/on-premises/developer/use-microsoft-dynamics-365-web-services?view=op-9-1#organization-service"
      ]
    },
    {
      "id": "web-resource-odata-v2",
      "kind": "web_resource",
      "class": "deprecated",
      "title": "Calls the deprecated OData v2 Organization Data Service",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "(?i)/XRMServices/2011/OrganizationData\\.svc",
        "web_resource_types": [
          1,
          3
        ]
      },
      "transform": "odata-v2",
      "fix": "Call the Web API (Xrm.WebApi, or /api/data/v9.x/) and drop helper libraries such as SDK.REST.js.",
      "sources": [
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/best-practices/business-logic/do-not-use-odata-v2-endpoint",
        "https://learn.microsoft.com/power-platform/important-changes-coming",
        "https://learn.microsoft.com/power-apps/maker/data-platform/powerapps-checker/rules/web/avoid-crm2011-service-odata"
      ]
    },
    {
      "id": "web-resource-jquery-static",
      "kind": "web_resource",
      "class": "blocker",
      "title": "Loads the jQuery 2.1.1 the app shipped, removed online in October 2023",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "online"
      ],
      "detection": {
        "type": "content_pattern",
        "pattern": "(?i)/_static/_common/scripts/jquery-2\\.1\\.1",
        "web_resource_types": [
          1,
          3
        ]
      },
      "fix": "Ship the jQuery version the code needs as your own web resource, or remove the dependency.",
      "sources": [
        "https://learn.microsoft.com/power-platform/important-changes-coming"
      ]
    },
    {
      "id": "assembly-storage-online",
      "kind": "plugin_assembly",
      "class": "blocker",
      "title": "Assembly stored outside the database (on disk or the GAC), which Dataverse online cannot run",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "online"
      ],
      "detection": {
        "type": "field_in",
        "field": "source_type",
        "values": [
          1,
          2
        ]
      },
      "fix": "Re-register the assembly with its location set to Database (Plug-in Registration Tool, or pac plugin push).",
      "sources": [
        "https://learn.microsoft.com/power-apps/developer/data-platform/register-plug-in#assembly-registration",
        "https://learn.microsoft.com/power-apps/developer/data-platform/reference/entities/pluginassembly"
      ]
    },
    {
      "id": "assembly-storage-onprem",
      "kind": "plugin_assembly",
      "class": "optional",
      "title": "Assembly stored outside the database (on disk or the GAC)",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1"
      ],
      "detection": {
        "type": "field_in",
        "field": "source_type",
        "values": [
          1,
          2
        ]
      },
      "fix": "Re-register the assembly with its location set to Database, which Microsoft strongly recommends for production plug-ins.",
      "sources": [
        "https://learn.microsoft.com/dynamics365/customerengagement/on-premises/developer/register-deploy-plugins?view=op-9-1",
        "https://learn.microsoft.com/power-apps/developer/data-platform/reference/entities/pluginassembly"
      ]
    },
    {
      "id": "assembly-isolation-none",
      "kind": "plugin_assembly",
      "class": "blocker",
      "title": "Assembly registered without isolation; Dataverse online runs plug-ins only in the sandbox",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "online"
      ],
      "detection": {
        "type": "field_in",
        "field": "isolation_mode",
        "values": [
          1
        ]
      },
      "fix": "Re-register the assembly in Sandbox isolation, and check its code against the sandbox limits (no GAC dependencies, HTTP and HTTPS only).",
      "sources": [
        "https://learn.microsoft.com/power-apps/developer/data-platform/register-plug-in#assembly-registration",
        "https://learn.microsoft.com/dynamics365/customerengagement/on-premises/developer/supported-extensions?view=op-9-1#customizations-using-the-dynamics-365-customer-engagement-on-premises-sdk",
        "https://learn.microsoft.com/power-apps/developer/data-platform/reference/entities/pluginassembly"
      ]
    },
    {
      "id": "assembly-isolation-none-onprem",
      "kind": "plugin_assembly",
      "class": "optional",
      "title": "Assembly registered without isolation",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1"
      ],
      "detection": {
        "type": "field_in",
        "field": "isolation_mode",
        "values": [
          1
        ]
      },
      "fix": "Consider Sandbox isolation, which a later move to Dataverse online requires; registering an unisolated assembly needs a Deployment Administrator.",
      "sources": [
        "https://learn.microsoft.com/dynamics365/customerengagement/on-premises/developer/register-deploy-plugins?view=op-9-1#security-restrictions",
        "https://learn.microsoft.com/power-apps/developer/data-platform/reference/entities/pluginassembly"
      ]
    },
    {
      "id": "csproj-sdk-net462",
      "kind": "plugin_assembly",
      "class": "blocker",
      "title": "The plug-in project targets .NET Framework below 4.6.2 or references the SDK 5.0 Microsoft.Xrm.Sdk or Microsoft.Crm.Sdk.Proxy assemblies",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "plugin_project"
      },
      "fix": "Retarget the project to .NET Framework 4.6.2 or later (4.8 for the newest platform features) and take Microsoft.Xrm.Sdk and Microsoft.Crm.Sdk.Proxy from the Microsoft.CrmSdk.CoreAssemblies package instead of the SDK 5.0 assemblies. `crm inventory convert --source-map MAP --repo REPO` writes the SDK-style project; the assembly is rebuilt and re-registered afterwards. Judged only for an assembly the source map matches to exactly one project: an unmapped assembly is not read, and an unreadable project is unknown.",
      "sources": [
        "https://learn.microsoft.com/power-apps/developer/data-platform/supported-customizations#support-for-net-framework-versions",
        "https://learn.microsoft.com/dynamics365/customerengagement/on-premises/developer/visual-studio-dot-net-framework?view=op-9-1"
      ]
    },
    {
      "id": "form-handler-no-execution-context",
      "kind": "form",
      "class": "deprecated",
      "title": "An enabled form handler does not pass the execution context to a library that uses Xrm.Page",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "form_handler_context",
        "library_rule": "web-resource-xrm-page"
      },
      "transform": "form-handler-context",
      "fix": "Select 'Pass execution context as first parameter' on the handler (passExecutionContext=\"true\") and take formContext from executionContext.getFormContext() in the function. Only enabled handlers are judged; a handler whose library cannot be read is unknown, not clear.",
      "sources": [
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/clientapi-execution-context",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/clientapi-form-context",
        "https://learn.microsoft.com/power-platform/important-changes-coming#some-client-apis-are-deprecated"
      ]
    },
    {
      "id": "ribbon-action-no-primary-control",
      "kind": "ribbon_diff",
      "class": "deprecated",
      "title": "A ribbon JavaScriptFunction calls a library that uses Xrm.Page without PrimaryControl among its CrmParameters",
      "source": {
        "from": "5.0",
        "before": null
      },
      "targets": [
        "onprem-9.1",
        "online"
      ],
      "detection": {
        "type": "ribbon_action_parameter",
        "library_rule": "web-resource-xrm-page",
        "parameter": "PrimaryControl"
      },
      "transform": "form-handler-context",
      "fix": "Add <CrmParameter Value=\"PrimaryControl\" /> as the first parameter of the action and take the form context from that argument in the function. Only actions on a $webresource: library are judged; one whose library cannot be read is unknown, not clear.",
      "sources": [
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/pass-data-page-parameter-ribbon-actions#form-and-grid-context-in-ribbon-actions",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/clientapi-form-context",
        "https://learn.microsoft.com/power-platform/important-changes-coming#some-client-apis-are-deprecated"
      ]
    }
  ]
}
