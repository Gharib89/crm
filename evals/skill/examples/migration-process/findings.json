  "rules_hit": {
    "assembly-isolation-none": {
      "class": "blocker",
      "fix": "Re-register the assembly in Sandbox isolation, and check its code against the sandbox limits (no GAC dependencies, HTTP and HTTPS only).",
      "sources": [
        "https://learn.microsoft.com/power-apps/developer/data-platform/register-plug-in#assembly-registration",
        "https://learn.microsoft.com/dynamics365/customerengagement/on-premises/developer/supported-extensions?view=op-9-1#customizations-using-the-dynamics-365-customer-engagement-on-premises-sdk",
        "https://learn.microsoft.com/power-apps/developer/data-platform/reference/entities/pluginassembly"
      ],
      "title": "Assembly registered without isolation; Dataverse online runs plug-ins only in the sandbox"
    },
    "assembly-storage-online": {
      "class": "blocker",
      "fix": "Re-register the assembly with its location set to Database (Plug-in Registration Tool, or pac plugin push).",
      "sources": [
        "https://learn.microsoft.com/power-apps/developer/data-platform/register-plug-in#assembly-registration",
        "https://learn.microsoft.com/power-apps/developer/data-platform/reference/entities/pluginassembly"
      ],
      "title": "Assembly stored outside the database (on disk or the GAC), which Dataverse online cannot run"
    },
    "form-handler-no-execution-context": {
      "class": "deprecated",
      "fix": "Select 'Pass execution context as first parameter' on the handler (passExecutionContext=\"true\") and take formContext from executionContext.getFormContext() in the function. Only enabled handlers are judged; a handler whose library cannot be read is unknown, not clear.",
      "sources": [
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/clientapi-execution-context",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/clientapi-form-context",
        "https://learn.microsoft.com/power-platform/important-changes-coming#some-client-apis-are-deprecated"
      ],
      "title": "An enabled form handler does not pass the execution context to a library that uses Xrm.Page"
    },
    "web-resource-crmform": {
      "class": "blocker",
      "fix": "Rewrite against the client API: crmForm.all.<attribute>.DataValue becomes formContext.getAttribute(\"<attribute>\").getValue(). crmForm is not part of the documented 9.x client API, and only the documented API is supported. Tool judgment: no Microsoft Learn page names crmForm; the sources are the closest statements.",
      "sources": [
        "https://learn.microsoft.com/dynamics365/customerengagement/on-premises/customize/customizations-supported?view=op-9-1",
        "https://learn.microsoft.com/power-apps/maker/data-platform/powerapps-checker/rules/web/avoid-2011-api"
      ],
      "title": "Uses the CRM 4.0 crmForm scripting object"
    },
    "web-resource-xrm-page": {
      "class": "deprecated",
      "fix": "Use the form context: take executionContext.getFormContext() in a form handler (pass the execution context as the first parameter), or PrimaryControl in a ribbon command.",
      "sources": [
        "https://learn.microsoft.com/power-platform/important-changes-coming#some-client-apis-are-deprecated",
        "https://learn.microsoft.com/power-apps/developer/model-driven-apps/clientapi/clientapi-form-context",
        "https://learn.microsoft.com/power-apps/maker/data-platform/powerapps-checker/rules/web/use-client-context"
      ],
      "title": "Uses the deprecated Xrm.Page object"
    }
  },
